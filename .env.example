# Copy this file to ".env" and fill in the keys you need.
# StudyBuddy reads these at startup. Never commit the real .env file.

# --- Generation LLM (required for real answers) ---
# Recommended: one OpenRouter key unlocks hundreds of models (Claude, GPT, Gemini…).
# Set llm.provider: "openrouter" in config.yaml and pick a model slug from
# https://openrouter.ai/models. Free-tier keys only work with ":free" models
# (e.g. nvidia/nemotron-3-super-120b-a12b:free — the default). Paid models need
# credits at https://openrouter.ai/settings/credits.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
# Native Anthropic API (only if llm.provider: "anthropic")
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# --- Embeddings (required unless embedding.provider = "fake") ---
# OpenAI text-embedding-3-small
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# Voyage AI (only if embedding.provider = "voyage")
# VOYAGE_API_KEY=paas-xxxxxxxxxxxx