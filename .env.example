# Copy this file to ".env" and fill in the keys you need.
# StudyBuddy reads these at startup. Never commit the real .env file.

# --- Generation LLM (required for real answers) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# --- Embeddings (required unless embedding.provider = "fake") ---
# OpenAI text-embedding-3-small
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# Voyage AI (only if embedding.provider = "voyage")
# VOYAGE_API_KEY=paas-xxxxxxxxxxxx